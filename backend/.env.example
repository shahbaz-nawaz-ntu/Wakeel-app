# Application Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/wakeel-app

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication & Sessions
SESSION_SECRET=jurisflow_session_secret_2024
JWT_SECRET=jurisflow_jwt_secret_2024
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=jurisflow_jwt_refresh_secret_2024
JWT_REFRESH_EXPIRE=30d

# OAuth Providers - Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# OAuth Providers - GitHub
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=/api/auth/github/callback

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# File Upload
# 5242880 = 5MB
MAX_FILE_SIZE=5242880

# Rate Limiting
# Window in minutes
RATE_LIMIT_WINDOW=15
# Max requests per window
RATE_LIMIT_MAX=100
